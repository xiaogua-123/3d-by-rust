(
    id: "elder_greeting",
    nodes: {
        "start": (
            speaker: "村长",
            text: "欢迎，旅行者！你终于来了。我们村子最近遇到了一些麻烦...",
            next: Some("ask_help"),
        ),
        "ask_help": (
            speaker: "村长",
            text: "东边的森林里出现了怪物，你能帮我们去调查一下吗？",
            choices: [
                (text: "好的，交给我吧。", next_id: "accept"),
                (text: "我考虑一下。", next_id: "reject"),
            ],
        ),
        "accept": (
            speaker: "村长",
            text: "太好了！请小心一点。这是给你的药草，受伤时可以用。",
            on_enter: [
                StartQuest("investigate_forest"),
                GiveItem("herb", 3),
            ],
            next: Some("farewell"),
        ),
        "reject": (
            speaker: "村长",
            text: "我理解。如果你改变主意，随时来找我。",
            next: Some("end"),
        ),
        "farewell": (
            speaker: "村长",
            text: "祝你好运，旅行者！",
            next: Some("end"),
        ),
        "end": (
            speaker: "",
            text: "",
            next: None,
        ),
    },
)
